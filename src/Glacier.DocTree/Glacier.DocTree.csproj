<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NuGet Packaging Properties -->
    <Version>1.1.0</Version>
    <PackageId>Glacier.DocTree</PackageId>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier</Company>
    <Description>A blazing fast Markdown parser and semantic document tree representation optimized for AI and LLM context extraction, featuring native Glacier.Storage .gdoc binary persistence.</Description>
    <PackageTags>markdown parser doctree semantic-tree llm context-bundler gdoc storage</PackageTags>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.DocTree</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Glacier.Storage" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj')">
    <ProjectReference Include="..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\Glacier.Polaris\src\Glacier.Polaris\Glacier.Polaris.csproj')">
    <PackageReference Include="Glacier.Polaris" Version="1.0.20" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\Glacier.Graph\src\Glacier.Graph\Glacier.Graph.csproj')">
    <ProjectReference Include="..\..\..\Glacier.Graph\src\Glacier.Graph\Glacier.Graph.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\Glacier.Graph\src\Glacier.Graph\Glacier.Graph.csproj')">
    <PackageReference Include="Glacier.Graph" Version="1.0.4" />
  </ItemGroup>

</Project>
